        public static int ModPow(int basis, int exponent, int p)                                     // performanter mit einer Methode für die Potenzrechnung
        {
            int ergebnis = 1;
            for (int i = 0; i < exponent; i++)
            {
                ergebnis = (ergebnis * basis) % p;
            }
            return ergebnis;
        }
