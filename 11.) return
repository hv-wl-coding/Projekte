Methoden die mit "void" (leer) defineirt werden benltigen keinen Rückgabetyp. Alle anderen emthoden geben den jeweiligen datentyp zurück.
Im "return" können z.B. ganze Ausführungen (wie Rehcnungen) stehen oder weitere Variablen, die z.B. ein Ergebnis dieser Rechnung speichern.
Für die jeweilige Ausgabe wird wieder der print-Befehl "Console.WriteLine()" benötigt, der entweder direkt den methodenaufruf beinhaltet oder die Ergebnisvariable.

using System;

namespace MeinProjekt
{
    class Program
    {
        static void Main(string[] args) 
        {       
            int result = Add(15, 23);                                                 // Methode aufrufen und Ergebnis in Variable speichern für die Ausgabe
            Console.WriteLine(result);
            Console.WriteLine(Add(15, 23));                                           // alternative Ausgabemöglichkeit mit der Methode im print
            Console.WriteLine(Add(Add(1,2), Add(3,4)));                               // Methodenaufrufe als Übergabewerte bzw. Argumente für die Methode, Ergebnis von 1+2 und Ergebnis von 3+4
            Console.WriteLine(Multiply(13,23));
            Console.ReadKey();  
        }

        public static int Add(int num1, int num2)                                      // zwei int Werte addieren und Ergebnis zurückgeben
        {
            return num1 + num2;                                                        // nicht leer (void) sondern int Ergebnis, ohne return funtioniert diese Methode nicht
        }

        public static double Multiply(double num1, double num2)                        // Beispiel für Multiplikation, Parameternamen num1 und num2 können mehrfach genutzt werden da sie nur innerhalb der Methode gelten
        {
            // return num3 * num4;                                                     // mit Alternative fürs "return"
            double result = num3 * num4; 
            return result;                                                             // geeignet wenn in der Methode mehrere Dinge passieren als nur ein einfaches Ergebnis als Rückgabe
        }
    }
}

Drei Freunde begrüßen ohn Rückgabewerte in 3 verschiedenen Varianten:

using System;

namespace MeinProjekt
{
    class Program
    {
        // Variante 1: die Methode 3x aufrufen mit unterschiedlichen Argumenten
        static void Main(string[] args) 
        {       
            string friend1 = "Kurt";
            string friend2 = "Marie";
            string friend3 = "Bob";

            GreetFriend(friend1);
            GreetFriend(friend2);
            GreetFriend(friend3);
            Console.ReadKey(); 
        }

        public static void GreetFriend(string friendName)
        {
           Console.WriteLine("Hallo {0}, mein Freund!", friendName);
        }
-------------------------------------------------------------------------------------------
        // Variante 2: 3 Parameter übergeben und die Methode 1x aufrufen mit 3 Argumenten
        static void Main(string[] args) 
        {       
            string friend1 = "Kurt";
            string friend2 = "Marie";
            string friend3 = "Bob";

            GreetFriend(friend1, friend2, friend3);
            Console.ReadKey(); 
        }

        public static void GreetFriend(string friendName1, string friendName2, string friendName3)
        {
           Console.WriteLine("Hallo {0}, mein Freund!", friendName1);
           Console.WriteLine("Hallo {0}, mein Freund!", friendName2);
           Console.WriteLine("Hallo {0}, mein Freund!", friendName3);
        }
----------------------------------------------------------------------------------------
        // Variante 3: alle Freund-Variablen durch einen einzigen String ausgeben, Methode mit 3 Parameter und aufruf mit entsprechend 3 Argumenten
        static void Main(string[] args) 
        {       
            string friend1 = "Kurt";
            string friend2 = "Marie";
            string friend3 = "Bob";

            GreetFriend(friend1, friend2, friend3);
            Console.ReadKey(); 
        }

        public static void GreetFriend(string friendName1, string friendName2, string friendName3)
        {
           Console.WriteLine("Hallo {0}, {1} und {2}, meine Freund!", friendName1, friendName2, friendName3);
        }
    }
}
